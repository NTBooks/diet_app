{
  "name": "dead-weight",
  "version": "1.0.0",
  "description": "A diet tracking app with meal logging and health monitoring",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run server\" \"wait-on http://localhost:3025 && electron .\"",
    "server": "node index.js",
    "web": "node index.js",
    "build": "electron-builder",
    "dist": "npm run build -- --publish=never",
    "migrate": "node run_migrations.js",
    "migrate:rollback": "node rollback_migration.js",
    "db:backup": "node -e \"const fs = require('fs'); const timestamp = new Date().toISOString().replace(/[:.]/g, '-'); fs.copyFileSync('./diet_app.db', './diet_app.db.backup.' + timestamp); console.log('Database backup created');\""
  },
  "keywords": [
    "diet",
    "health",
    "calories",
    "tracking"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "sqlite3": "^5.1.6"
  },
  "build": {
    "appId": "com.yourname.dead-weight",
    "productName": "Dead Weight",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.js",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}