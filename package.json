{
  "name": "diet-app",
  "version": "1.0.0",
  "description": "A diet tracking app with calorie lookup and health monitoring",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run server\" \"wait-on http://localhost:3000 && electron .\"",
    "server": "node index.js",
    "build": "electron-builder",
    "dist": "npm run build -- --publish=never"
  },
  "keywords": [
    "diet",
    "health",
    "calories",
    "tracking"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "axios": "^1.6.0"
  },
  "build": {
    "appId": "com.yourname.diet-app",
    "productName": "Diet App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.js",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}